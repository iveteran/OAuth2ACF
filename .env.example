OAUTH2ACF_LISTEN_ADDRESS=127.0.0.1:9090
OAUTH2ACF_DATABASE_PATH=/var/lib/oauth2acf/oauth2.db

# Existing legacy session/token encryption settings.
OAUTH2ACF_JWT_SECRET=replace-with-a-random-secret
OAUTH2ACF_TOKEN_KEY=replace-with-a-random-secret

# Ed25519 private key used only to sign short-lived icchat-fcm registration
# tokens. Mount the corresponding public key in icchat-fcm.
OAUTH2ACF_PUSH_SIGNING_KEY_FILE=/run/secrets/push-signing-private.pem
OAUTH2ACF_PUSH_ISSUER=icchat-accounts
OAUTH2ACF_PUSH_AUDIENCE=icchat-push

# Shared only with icchat-fcm's account broker client.
OAUTH2ACF_PUSH_BROKER_KEY_FILE=/run/secrets/push-broker-key

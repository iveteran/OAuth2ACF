# compose.yaml overrides these with container paths and a container listen
# address. They remain useful when running the binary directly.
OAUTH2ACF_LISTEN_ADDRESS=127.0.0.1:9090
OAUTH2ACF_DATABASE_PATH=./data/oauth2.db
OAUTH2ACF_CLIENTS_FILE=./secrets/oauth-clients.json

# Existing legacy session and provider credential encryption settings. Compose
# should use read-only files so values do not appear in docker inspect.
OAUTH2ACF_JWT_SECRET_FILE=/run/secrets/legacy-jwt-key
OAUTH2ACF_TOKEN_KEY_FILE=/run/secrets/token-encryption-key
# Direct-value compatibility alternatives (never set both forms):
# OAUTH2ACF_JWT_SECRET=replace-with-a-long-random-secret
# OAUTH2ACF_TOKEN_KEY=replace-with-a-different-long-random-secret

# Ed25519 private key used only to sign short-lived icchat-fcm registration
# tokens. Mount the corresponding public key in icchat-fcm.
OAUTH2ACF_PUSH_SIGNING_KEY_FILE=/run/secrets/push-signing-private.pem
OAUTH2ACF_PUSH_ISSUER=icchat-accounts
OAUTH2ACF_PUSH_AUDIENCE=icchat-push

# Shared only with icchat-fcm's account broker client.
OAUTH2ACF_PUSH_BROKER_KEY_FILE=/run/secrets/push-broker-key
